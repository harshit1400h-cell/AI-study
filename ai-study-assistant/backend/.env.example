# =============================================================================
# AI Study Assistant — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Lines starting with # are comments.
# =============================================================================

# ---------- LLM Provider ----------
# Choose: "gemini", "openai", or "none" (disables AI features, keeps upload/retrieval)
LLM_PROVIDER=gemini

# Google Gemini (free tier: 15 RPM)
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI (paid, ~$0.15/1M tokens for gpt-4o-mini)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Gemini model name
GEMINI_MODEL=gemini-1.5-flash

# ---------- Embeddings ----------
# Local model — no API key needed
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---------- ChromaDB ----------
CHROMA_PERSIST_DIR=./chroma_db

# ---------- Upload ----------
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads

# ---------- Server ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---------- Security ----------
# Set a secret key for production
SECRET_KEY=change-me-in-production

